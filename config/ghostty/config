#window-decoration=none
font-family="Mononoki Nerd Font"
font-size=16
theme=nordfox
window-width=140
window-height=45

keybind=super+shift+e=toggle_fullscreen

keybind=super+shift+r=reload_config

keybind=super+shift+s=new_split:down
keybind=super+shift+v=new_split:right
keybind=super+shift+f=toggle_split_zoom
keybind=super+shift+;=goto_split:right
keybind=super+shift+j=goto_split:left
keybind=super+shift+k=goto_split:down
keybind=super+shift+l=goto_split:up

keybind=super+shift+n=increase_font_size:1
keybind=super+shift+p=decrease_font_size:1
